rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function invOwner(invitationId) {
      return isSignedIn() && get(/databases/$(database)/documents/invitations/$(invitationId)).data.userId == request.auth.uid;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'contact.media.vnn@gmail.com' ||
        request.auth.token.email == 'admin@thieponl.vn'
      );
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // USERS
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) || isAdmin();
      // Lượt miễn phí chỉ được ghi 1 lần, không được xóa để tạo lại
      allow update: if isAdmin() || (isOwner(userId) && (
        !('freeInvitationId' in resource.data) || resource.data.freeInvitationId == null ||
        request.resource.data.freeInvitationId == resource.data.freeInvitationId
      ));
    }

    // INVITATIONS
    match /invitations/{invitationId} {
      allow get: if resource.data.status == 'published' || (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();
      allow list: if (isSignedIn() && resource.data.userId == request.auth.uid) || resource.data.status == 'published' || isAdmin();
      allow create: if isSignedIn() && (request.resource.data.userId == request.auth.uid || isAdmin());
      allow update, delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());

      // GUESTS — ID khách là token bí mật trong link riêng (?g=...)
      match /guests/{guestId} {
        allow list, create, delete: if invOwner(invitationId) || isAdmin();
        // Khách mở link riêng: chỉ đọc đúng 1 bản ghi theo ID
        allow get: if true;
        allow update: if invOwner(invitationId) || isAdmin() ||
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['rsvpStatus', 'attendeesCount', 'respondedAt', 'lastViewedAt', 'viewCount', 'giftSent']);
      }

      // GIFTS — khách xác nhận đã gửi quà mừng
      match /gifts/{giftId} {
        allow create: if request.resource.data.senderName is string && request.resource.data.senderName.size() <= 120;
        allow read, delete: if invOwner(invitationId) || isAdmin();
      }

      // RSVPS
      match /rsvps/{rsvpId} {
        allow create: if request.resource.data.guestName is string;
        allow read, delete: if (isSignedIn() && get(/databases/$(database)/documents/invitations/$(invitationId)).data.userId == request.auth.uid) || isAdmin();
      }

      // WISHES
      match /wishes/{wishId} {
        allow read: if resource.data.isApproved == true || (isSignedIn() && get(/databases/$(database)/documents/invitations/$(invitationId)).data.userId == request.auth.uid) || isAdmin();
        allow create: if request.resource.data.senderName is string && request.resource.data.message is string
          && (!('signature' in request.resource.data) || (request.resource.data.signature is string && request.resource.data.signature.size() < 300000));
        allow update, delete: if (isSignedIn() && get(/databases/$(database)/documents/invitations/$(invitationId)).data.userId == request.auth.uid) || isAdmin();
      }
    }

    // NOTIFICATIONS — thông báo realtime cho chủ thiệp
    match /notifications/{notificationId} {
      allow create: if request.resource.data.ownerId is string
        && request.resource.data.read == false
        && request.resource.data.type in ['wish', 'rsvp', 'gift', 'view']
        && get(/databases/$(database)/documents/invitations/$(request.resource.data.invitationId)).data.userId == request.resource.data.ownerId;
      allow read, delete: if (isSignedIn() && resource.data.ownerId == request.auth.uid) || isAdmin();
      allow update: if isSignedIn() && resource.data.ownerId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
    }

    // PREVIEWS — bản xem trước bí mật (khóa ngẫu nhiên) để quét QR xem thiệp khi đang soạn
    match /previews/{previewKey} {
      allow get: if true;
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;
    }

    // ORDERS
    match /orders/{orderId} {
      allow read: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();
      allow create: if isSignedIn() && (request.resource.data.userId == request.auth.uid || isAdmin());
      allow update: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();
    }

    // PAYMENTS
    match /payments/{paymentId} {
      allow read: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();
      allow create, update: if isAdmin();
    }

    // ADMIN ACTIONS
    match /adminActions/{actionId} {
      allow read, create: if isAdmin();
    }
  }
}

